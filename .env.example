# ───────────────────────────────────────────────────────────────────────────
# AuraClip AI — Environment Variables
# ───────────────────────────────────────────────────────────────────────────
# HOW TO USE THIS FILE:
#   1. Make a copy of this file and name the copy ".env.local"
#        (in the terminal:  cp .env.example .env.local )
#   2. Fill in the real values below (replace every "your-..." placeholder).
#   3. NEVER commit .env.local — it is already in .gitignore. Only this
#      .env.example file (with placeholders) is safe to commit to GitHub.
#
# Variables that start with NEXT_PUBLIC_ are sent to the browser, so they are
# safe to be "public". Anything WITHOUT that prefix is server-only and secret.
# ───────────────────────────────────────────────────────────────────────────


# ── Supabase ────────────────────────────────────────────────────────────────
# Where to find these:
#   1. Go to https://supabase.com and create a free account + a new project.
#   2. In your project, open:  Settings (gear icon) → API
#   3. Copy the two values below from that page.

# "Project URL" — looks like https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# "Project API keys" → the "anon" / "public" key (a long string).
# This key is safe to expose in the browser; Supabase Row Level Security
# protects your data. Do NOT use the "service_role" key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key


# ── App URL ─────────────────────────────────────────────────────────────────
# The base URL of your app. Used to build the Google login redirect link.
#   - Local development:  http://localhost:3000
#   - On Vercel:          https://your-app-name.vercel.app  (set it in the
#                         Vercel dashboard, NOT here)
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ───────────────────────────────────────────────────────────────────────────
# GOOGLE LOGIN — no extra variables go in this file.
# Google OAuth is configured INSIDE the Supabase dashboard, not here:
#   Supabase → Authentication → Providers → Google
# You paste your Google "Client ID" and "Client Secret" there.
# (Get those from https://console.cloud.google.com → APIs & Services →
#  Credentials → Create OAuth client ID → Web application.)
# See docs/SETUP.md for the full step-by-step.
# ───────────────────────────────────────────────────────────────────────────

# -- AssemblyAI (transcription) -----------------------------------------------
# Turns the uploaded video's audio into word-timed text.
# Where to get it: https://www.assemblyai.com -> sign up (free credits) ->
#   Dashboard -> copy your API key.
# Server-only secret (NO NEXT_PUBLIC_ prefix) — never exposed to the browser.
ASSEMBLYAI_API_KEY=your-assemblyai-api-key
# -- Anthropic (AI clip detection) --------------------------------------------
# Claude reads the transcript and picks the best clip moments.
# Where to get it: https://console.anthropic.com -> sign in -> API keys ->
#   Create key. Add credits/billing on the same site.
# Server-only secret (NO NEXT_PUBLIC_ prefix).
ANTHROPIC_API_KEY=your-anthropic-api-key
# -- Render worker (server-only; used by worker/render.mjs) --------------------
# The render worker needs the Supabase SERVICE ROLE key (a master key) to read
# any user's clip and write the finished MP4 back. Find it in:
#   Supabase -> Settings -> API -> Project API keys -> service_role (secret)
# KEEP THIS SECRET. It is only used locally by the worker, never in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# -- Stripe (billing / buying credits) ----------------------------------------
# From https://dashboard.stripe.com -> Developers -> API keys (use TEST keys
# while developing). Server-only secrets.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# After creating a webhook endpoint (Developers -> Webhooks) pointing at
#   https://your-app.vercel.app/api/billing/webhook  (event: checkout.session.completed)
# copy its "Signing secret" here.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# NOTE: the Stripe webhook (on Vercel) ALSO needs SUPABASE_SERVICE_ROLE_KEY
# (defined above) set in your Vercel environment variables to grant credits.